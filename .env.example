# ==============================================================================
# ZenWeb Extension Environment Configuration
# ==============================================================================
# Note: ZenWeb uses Chrome's on-device Gemini Nano Built-in AI by default
# (100% private and offline with local NLP fallbacks, requiring zero API keys).
# If you optionally configure external cloud AI endpoints, add your keys below.
# Copy this file to .env and never commit .env to version control!

# Optional Gemini Cloud API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Environment Mode (development | production)
ZENWEB_ENV=development
